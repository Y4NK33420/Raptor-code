# Copy to .env and fill in. .env is gitignored.
GEMINI_API_KEY=
# Optional extra keys: calls are spread across them, with failover when one is rate-limited.
# Quotas are per Google Cloud project, so keys only add capacity if they come from different projects.
# GEMINI_API_KEY2=
# GEMINI_API_KEY3=
# Optional overrides (defaults shown)
# RAPTOR_CACHE_DIR=.cache/raptor
# RAPTOR_GEMINI_RPM=15
# RAPTOR_OLLAMA_HOST=http://localhost:11434
